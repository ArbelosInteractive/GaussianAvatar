{
    "$schema": "https://raw.githubusercontent.com/jetify-com/devbox/0.14.2/.schema/devbox.schema.json",
    "packages": [
        "python@3.10",
        "cudaPackages_11_8.cudatoolkit",
        "gcc@11",
        "mesa"
    ],
    "nixpkgs": {
        "allowUnfree": true
    },
    "shell": {
        "init_hook": [
            ". $VENV_DIR/bin/activate",
            "export LD_LIBRARY_PATH=$(pwd)/.devbox/nix/profile/default/lib:/usr/lib/wsl/lib:/nix/store/2nmbapxhrl1yv752f9aiy67kmgnclbmk-libglvnd-1.6.0/lib:/usr/lib/x86_64-linux-gnu:/lib:/usr/lib:/lib64:",
            "export CUDA_HOME=`pwd`/.devbox/nix/profile/default/"
        ],
        "scripts": {
            "test": [
                "echo \"Error: no test specified\" && exit 1"
            ]
        }
    },
    "env": {
        "MAX_JOBS": "4",
        "NIXPKGS_ALLOW_UNFREE": "1"
    }
}